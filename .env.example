# Copy to .env and adjust if needed.

# PostgreSQL
POSTGRES_USER=steam
POSTGRES_PASSWORD=steam
POSTGRES_DB=steam2026
POSTGRES_PORT=5432

# Backend (inside Docker the host is "db"; for local dev use localhost)
DATABASE_URL=postgresql+asyncpg://steam:steam@db:5432/steam2026

# App
APP_ENV=development
LOG_LEVEL=INFO

# Optional: Gamalytic API key (paid) — enables wishlist/revenue/sales
# estimates in the Phase 4 market collector. Without it those values
# honestly stay Unknown (no free public estimate API exists as of Aug 2026).
GAMALYTIC_API_KEY=
