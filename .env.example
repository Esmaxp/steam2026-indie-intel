# Copy to .env and adjust if needed.

# PostgreSQL
POSTGRES_USER=steam
POSTGRES_PASSWORD=steam
POSTGRES_DB=steam2026
POSTGRES_PORT=5432

# Backend (inside Docker the host is "db"; for local dev use localhost)
DATABASE_URL=postgresql+asyncpg://steam:steam@db:5432/steam2026

# App
APP_ENV=development
LOG_LEVEL=INFO

# Optional: Gamalytic API key (paid) — enables wishlist/revenue/sales
# estimates in the Phase 4 market collector. Without it those values
# honestly stay Unknown (no free public estimate API exists as of Aug 2026).
GAMALYTIC_API_KEY=

# Community Clips (frontend, server-side only — never exposed to the browser)
# YouTube Data API v3: https://console.cloud.google.com/apis (enable YouTube Data API, create key)
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
# Twitch Helix: https://dev.twitch.tv/console/apps (Client ID + secret, app token flow)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_USER_LOGIN=
