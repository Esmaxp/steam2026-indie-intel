# Copy to .env and adjust if needed:  cp .env.example .env
# The defaults below boot the full stack with NO real API keys — every
# key-dependent feature degrades gracefully when its key is empty.

# ---------------------------------------------------------------- database --
# REQUIRED (defaults work out of the box). Credentials for the bundled
# PostgreSQL container; also baked into DATABASE_URL below.
POSTGRES_USER=steam
POSTGRES_PASSWORD=steam
POSTGRES_DB=steam2026
# Host port PostgreSQL is published on. Change if 5432 is already in use.
POSTGRES_PORT=5432

# REQUIRED. Used by the backend/workers. Inside Docker the host is "db";
# for local (non-Docker) development use localhost instead.
DATABASE_URL=postgresql+asyncpg://steam:steam@db:5432/steam2026

# --------------------------------------------------------------------- app --
# OPTIONAL. development | production — informational only.
APP_ENV=development
# OPTIONAL. Python logging level for backend and workers: DEBUG|INFO|WARNING.
LOG_LEVEL=INFO

# ------------------------------------------------------------- market data --
# OPTIONAL. Gamalytic API key (paid) — enables wishlist/revenue/sales
# estimates in the Phase 4 market collector. Empty = those values honestly
# stay "Unknown" (no data is invented); everything else still works.
GAMALYTIC_API_KEY=

# -------------------------------------------------- community videos (API) --
# OPTIONAL as a group. Used by BOTH the frontend Community page and the
# backend per-game video feature. Empty = that platform is skipped and the
# UI shows a graceful "not configured / no videos" state — nothing breaks.
#
# YouTube Data API v3 key: https://console.cloud.google.com/apis
# (enable "YouTube Data API v3", create an API key)
YOUTUBE_API_KEY=
# OPTIONAL. Channel shown on the global /community page (frontend only).
YOUTUBE_CHANNEL_ID=
# Twitch Helix app credentials: https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# OPTIONAL. Twitch channel shown on the global /community page (frontend only).
TWITCH_USER_LOGIN=

# ------------------------------------------------------ admin review access --
# REQUIRED to review "add your channel" submissions at /admin/submissions
# (any long random string; header X-Admin-Token). Empty = the admin API
# returns 503 "not configured"; the rest of the site is unaffected.
ADMIN_TOKEN=

# ----------------------------------------------- optional tuning (backend) --
# These have safe defaults in backend/app/core/config.py and normally do NOT
# need to be set. Uncomment to override.
# Daily third-party API budgets (units/day) for per-game video fetching —
# the safety net that stops a traffic spike from draining the real quota:
#YOUTUBE_DAILY_QUOTA=8000
#TWITCH_DAILY_QUOTA=50000
# Per-game video cache lifetime (hours):
#VIDEO_CACHE_TTL_HOURS=24
# Minimum minutes between channel-form submissions from the same IP:
#SUBMISSION_COOLDOWN_MINUTES=10
